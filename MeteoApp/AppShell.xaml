<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MeteoApp"
       x:Class="MeteoApp.AppShell">
    <TabBar>
        <ShellContent Title="Home" Icon="home.svg" ContentTemplate="{DataTemplate local:MeteoListPage}" />
        <ShellContent Title="Current Location" Icon="dotnet_bot.svg" ContentTemplate="{DataTemplate local:CurrentLocationPage}" />
        <ShellContent Title="Map" Icon="map.svg" ContentTemplate="{DataTemplate local:MapPage}" />
    </TabBar>
    
</Shell>