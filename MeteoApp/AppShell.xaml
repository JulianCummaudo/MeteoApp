<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MeteoApp"
       xmlns:res="clr-namespace:MeteoApp.Resources.Strings"
       x:Class="MeteoApp.AppShell">
    <TabBar>
        <ShellContent Title="{x:Static res:AppResources.TabHome}"
                      Icon="home.svg"
                      ContentTemplate="{DataTemplate local:MeteoListPage}"/>
        <ShellContent Title="{x:Static res:AppResources.TabCurrentLocation}"
                      Icon="pin.svg"
                      ContentTemplate="{DataTemplate local:CurrentLocationPage}"/>
        <ShellContent Title="{x:Static res:AppResources.TabMap}"
                      Icon="map.svg"
                      ContentTemplate="{DataTemplate local:MapPage}"/>
        <ShellContent Title="{x:Static res:AppResources.TabBlazor}"
                      Icon="html.svg"
                      ContentTemplate="{DataTemplate local:BlazorPage}"/>
    </TabBar>

</Shell>