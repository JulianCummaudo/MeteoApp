@page "/current"

@using MeteoApp.Models
@using MeteoApp.Services
@inject MeteoService MeteoService

<PageTitle>Weather Dashboard</PageTitle>

<div class="container py-4">

    <h1 class="text-center mb-4">Weather Dashboard</h1>

    @if (loading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-3">Loading weather data...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger text-center">
            @errorMessage
        </div>
    }
    else if (meteo != null)
    {
        <div class="card shadow-lg border-0 mx-auto"
             style="max-width:700px; border-radius:25px; overflow:hidden;">

            <!-- Header -->
            <div class="text-white p-4"
                 style="background: linear-gradient(135deg,#0d6efd,#6ea8fe);">

                <div class="row align-items-center">

                    <div class="col-8">
                        <h2>@meteo.CityName</h2>
                        <p class="mb-1 text-capitalize">@meteo.Description</p>
                        <small>@meteo.DateTime.ToString("dddd dd MMMM HH:mm")</small>
                    </div>

                    <div class="col-4 text-end">
                        <img src="@meteo.IconUrl" width="90" />
                    </div>

                </div>

                <div class="mt-3">
                    <span style="font-size:3rem; font-weight:700;">
                        @Math.Round(meteo.Main.Temp)°C
                    </span>
                </div>
            </div>

            <!-- Details -->
            <div class="p-4 bg-white">

                <div class="row g-3 text-center">

                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <div class="fw-bold">Feels Like</div>
                            <div>@Math.Round(meteo.Main.FeelsLike)°C</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <div class="fw-bold">Humidity</div>
                            <div>@meteo.Main.Humidity%</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <div class="fw-bold">Pressure</div>
                            <div>@meteo.Main.Pressure hPa</div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <div class="fw-bold">Visibility</div>
                            <div>@(meteo.Visibility / 1000.0) km</div>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <p class="text-center text-muted mb-0">
                    Current weather in <strong>@meteo.CityName</strong> is
                    <strong>@meteo.Description</strong> with a temperature of
                    <strong>@Math.Round(meteo.Main.Temp)°C</strong>.
                </p>

            </div>
        </div>
    }

</div>

@code {

    private MeteoResponse? meteo;
    private bool loading = true;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // See the weather in Lugano
            var location = new Location(46.0037, 8.9511);

            meteo = await MeteoService.GetConditionsAsync(location);

            if (meteo == null)
                errorMessage = "Unable to load weather data.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}