<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeteoApp.MeteoItemPage"
             Title="Dettagli Città">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Elimina" Clicked="OnDeleteClicked" IconImageSource="delete.svg"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Spacing="20" Padding="16">
            
            <!-- Intestazione con icona e nome -->
            <Grid ColumnDefinitions="100, *" ColumnSpacing="16">
                <Image Grid.Column="0"
                       Source="{Binding Meteo.IconUrl}"
                       WidthRequest="80"
                       HeightRequest="80"
                       VerticalOptions="Center"/>
                
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                    <Label Text="{Binding City.Name}"
                           FontSize="28"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding City.Country}"
                           FontSize="14"
                           TextColor="#888888"/>
                </StackLayout>
            </Grid>

            <!-- Informazioni meteo principali -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="16" RowSpacing="16">
                    
                    <!-- Temperatura -->
                    <StackLayout Grid.Column="0" Grid.Row="0" Spacing="4">
                        <Label Text="Temperatura" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Temp, StringFormat='{0:F1}°C'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#FF6B6B"/>
                    </StackLayout>

                    <!-- Percepita -->
                    <StackLayout Grid.Column="1" Grid.Row="0" Spacing="4">
                        <Label Text="Percepita" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.FeelsLike, StringFormat='{0:F1}°C'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#4ECDC4"/>
                    </StackLayout>

                    <!-- Umidità -->
                    <StackLayout Grid.Column="0" Grid.Row="1" Spacing="4">
                        <Label Text="Umidità" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Humidity, StringFormat='{0}%'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#95E1D3"/>
                    </StackLayout>

                    <!-- Pressione -->
                    <StackLayout Grid.Column="1" Grid.Row="1" Spacing="4">
                        <Label Text="Pressione" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Pressure, StringFormat='{0} hPa'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#F7DC6F"/>
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Descrizione meteo -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="Condizioni" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Description}"
                           FontSize="16"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Vento -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="Vento" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Wind.Speed, StringFormat='Velocità: {0:F1} m/s'}"
                           FontSize="14"
                           TextColor="#333333"/>
                    <Label Text="{Binding Meteo.Wind.Deg, StringFormat='Direzione: {0}°'}"
                           FontSize="14"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Visibilità -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="Visibilità" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Visibility, StringFormat='{0} m'}"
                           FontSize="14"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Data/Ora -->
            <Label Text="{Binding Meteo.DateTime, StringFormat='Ultimo aggiornamento: {0:g}'}"
                   FontSize="12"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   Margin="0,16"/>
        </StackLayout>
    </ScrollView>
</ContentPage>

