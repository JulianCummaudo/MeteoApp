<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:MeteoApp.Resources.Strings"
             x:Class="MeteoApp.CurrentLocationPage">

    <ScrollView>
        <StackLayout Spacing="20" Padding="16">
            
            <!-- Intestazione con icona e nome -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16">
                <Image Grid.Column="0"
                    Source="{Binding Meteo.IconUrl}"
                    WidthRequest="80"
                    HeightRequest="80"
                    VerticalOptions="Center"/>

                <Label Grid.Column="1"
                    Text="{Binding Meteo.CityName}"
                    FontSize="28"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"/>
            </Grid>

            <!-- Informazioni meteo principali -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="16" RowSpacing="16">
                    
                    <!-- Temperatura -->
                    <StackLayout Grid.Column="0" Grid.Row="0" Spacing="4">
                        <Label Text="{x:Static res:AppResources.Temperature}" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Temp, StringFormat='{0:F1}°C'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#FF6B6B"/>
                    </StackLayout>

                    <!-- Percepita -->
                    <StackLayout Grid.Column="1" Grid.Row="0" Spacing="4">
                        <Label Text="{x:Static res:AppResources.FeelsLikeTemperature}" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.FeelsLike, StringFormat='{0:F1}°C'}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#4ECDC4"/>
                    </StackLayout>

                    <!-- Umidità -->
                    <StackLayout Grid.Column="0" Grid.Row="1" Spacing="4">
                        <Label Text="{x:Static res:AppResources.Humidity}" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Humidity, StringFormat='{0}%'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#95E1D3"/>
                    </StackLayout>

                    <!-- Pressione -->
                    <StackLayout Grid.Column="1" Grid.Row="1" Spacing="4">
                        <Label Text="{x:Static res:AppResources.Pressure}" FontSize="12" TextColor="#666666" FontAttributes="Bold"/>
                        <Label Text="{Binding Meteo.Main.Pressure, StringFormat='{0} hPa'}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#F7DC6F"/>
                    </StackLayout>
                </Grid>
            </Border>

            <!-- Descrizione meteo -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Conditions}" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Description}"
                           FontSize="16"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Vento -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Wind}" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Wind.Speed, StringFormat='Velocità: {0:F1} m/s'}"
                           FontSize="14"
                           TextColor="#333333"/>
                    <Label Text="{Binding Meteo.Wind.Deg, StringFormat='Direzione: {0}°'}"
                           FontSize="14"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Visibilità -->
            <Border Stroke="#CCCCCC"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    BackgroundColor="#F5F5F5">
                <StackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Visibility}" FontSize="14" FontAttributes="Bold" TextColor="#666666"/>
                    <Label Text="{Binding Meteo.Visibility, StringFormat='{0} m'}"
                           FontSize="14"
                           TextColor="#333333"/>
                </StackLayout>
            </Border>

            <!-- Data/Ora -->
            <StackLayout Spacing="4" orientation="Horizontal">
                <Label Text="{x:Static res:AppResources.LastUpdate}"
                    FontSize="12"
                    TextColor="#AAAAAA"
                    HorizontalOptions="Center"
                    Margin="0,16"/>

                <Label Text="{Binding Meteo.DateTime, StringFormat=' {0:g}'}"
                    FontSize="12"
                    TextColor="#AAAAAA"
                    HorizontalOptions="Center"
                    Margin="0,16"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>

