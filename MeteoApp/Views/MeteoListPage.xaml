<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MeteoApp.Converters"
             x:Class="MeteoApp.MeteoListPage">

    <ContentPage.Resources>
        <converters:WeatherIconConverter x:Key="WeatherIconConverter"/>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"
                Clicked="OnItemAdded"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <CollectionView x:Name="zlistView"
                        Margin="16"
                        ItemsSource="{Binding Entries}"
                        ItemsUpdatingScrollMode="KeepItemsInView">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Transparent"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#5a87e0d0"
                            Padding="16">

                        <Grid ColumnDefinitions="64, *, Auto">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnListItemSelected"/>
                            </Grid.GestureRecognizers>

                            <Image Grid.Column="0"
                                   Source="{Binding Meteo.IconUrl, Converter={StaticResource WeatherIconConverter}}"
                                   WidthRequest="48"
                                   HeightRequest="48"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                            <StackLayout Grid.Column="1"
                                         Orientation="Vertical"
                                         VerticalOptions="Center"
                                         Margin="12,0,0,0">
                                <Label Text="{Binding City.Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding City.Country}"
                                       FontSize="13"
                                       TextColor="#888888"/>
                            </StackLayout>

                            <Label Grid.Column="2"
                                   Text="{Binding Meteo.Main.Temp, StringFormat='{0:F1}°C'}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
