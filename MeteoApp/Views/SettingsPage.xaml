<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:MeteoApp.Resources.Strings"
             x:Class="MeteoApp.SettingsPage"
             Title="{x:Static res:AppResources.Settings}">
    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="16">
            <Label Text="{x:Static res:AppResources.Language}"
                   FontSize="20"
                   FontAttributes="Bold"/>

            <Border Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#5a87e0d0"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Picker x:Name="LanguagePicker"
                            ItemsSource="{Binding Languages}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                            Title="{x:Static res:AppResources.SelectLanguage}"/>
                    <Label Text="{x:Static res:AppResources.SelectLanguageHint}"
                           FontSize="12"
                           TextColor="#888888"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>